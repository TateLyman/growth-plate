atlas/data/supplied_2026_08_12/*.ontology
atlas/data/supplied_2026_08_12/*.tar
atlas/data/supplied_2026_08_12/spatial_bone_growth/

# Bulk supplied data 2026-08-13 - manifest committed, binaries not (GitHub 100MB limit)
atlas/data/supplied_2026_08_13/*.tsv
